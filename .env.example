# Скопируйте этот файл в .env и впишите свои значения:
#   Windows (PowerShell):  copy .env.example .env
#   macOS / Linux:         cp .env.example .env
#   либо просто перетащите в папку проекта
# Файл .env нельзя коммитить: у каждого участника свой ключ.
# Потеряете ключ и на вас запишут изучение материалов по созданию динамита.

# Ключ авторизации GigaChat API (личный кабинет developers.sber.ru -> GigaChat API).
# Чтобы его получить нужно заходить через SberID, вводите там телефон и всё норм
# Одна строка, без кавычек и пробелов. Проверка: python -m core.llm_client
GIGACHAT_CREDENTIALS=

# Подключать ли настоящего проверяющего (agents/checker) к API и интерфейсу.
# 0 или пусто = заглушки (ключ не нужен), 1 = настоящий проверяющий (нужен ключ).
USE_REAL_CHECKER=0
